DEFAULT_AI_PROVIDER=openai

OPENAI_API_KEY=sk-...
# Model to use. gpt-4o-2024-08-06 supports structured outputs with the Responses API.
OPENAI_MODEL=gpt-4o-2024-08-06

ANTHROPIC_API_KEY=sk-ant-...
# Model to use for Anthropic generation.
ANTHROPIC_MODEL=claude-opus-4-1

# Upload directory for incoming Word documents
UPLOAD_DIR=/tmp/h5p-creator/uploads
# Output directory for generated .h5p files
OUTPUT_DIR=/tmp/h5p-creator/outputs

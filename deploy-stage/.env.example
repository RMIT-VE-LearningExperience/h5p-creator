DEFAULT_AI_PROVIDER=openai

OPENAI_API_KEY=sk-...
# Model to use. gpt-4o-2024-08-06 supports structured outputs with the Responses API.
OPENAI_MODEL=gpt-4o-2024-08-06

ANTHROPIC_API_KEY=sk-ant-...
# Model to use for Anthropic generation.
ANTHROPIC_MODEL=claude-opus-4-1

# Optional server-managed Canvas connection. Users can instead connect per page.
CANVAS_BASE_URL=https://your-institution.instructure.com
CANVAS_API_TOKEN=
# Comma-separated custom Canvas hosts; *.instructure.com is allowed automatically.
CANVAS_ALLOWED_HOSTS=

# YouTube search and transcript retrieval.
YOUTUBE_API_KEY=
# Cloud hosts are commonly blocked by YouTube. Configure either Webshare
# residential credentials or one generic rotating residential proxy URL.
YOUTUBE_TRANSCRIPT_WEBSHARE_USERNAME=
YOUTUBE_TRANSCRIPT_WEBSHARE_PASSWORD=
YOUTUBE_TRANSCRIPT_PROXY_URL=

# Upload directory for incoming Word documents
UPLOAD_DIR=/tmp/h5p-creator/uploads
# Output directory for generated .h5p files
OUTPUT_DIR=/tmp/h5p-creator/outputs
